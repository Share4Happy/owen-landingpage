# Base URL for production site (e.g., https://username.github.io/owen/ or https://owen.vn)
VITE_SITE_URL=https://username.github.io/owen/

# Base path for deployment (e.g., '/' or '/owen/' or './')
VITE_BASE_PATH=./

# WordPress REST API Config
VITE_WP_API_URL=https://share4happy.com/wp-json/wp/v2/posts
VITE_WP_CATEGORY_ID=208
VITE_WP_POSTS_PER_PAGE=5

# Lead form submission webhook endpoint (leave blank if not yet configured)
VITE_FORM_ENDPOINT=

